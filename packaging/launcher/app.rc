#include <winver.h>

// 应用图标：由 package-installer.mjs 从 app-icon.png 生成
1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,0,0
 PRODUCTVERSION  1,0,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "acfun-download"
            VALUE "FileDescription",  "AcFun 下载"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "acfun"
            VALUE "OriginalFilename", "AcFun下载.exe"
            VALUE "ProductName",      "AcFun 视频下载"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
