{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AcFun下载",
  "version": "0.7.0",
  "identifier": "com.acfunit.acfun-download",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.ico",
      "iconAsTemplate": false,
      "tooltip": "AcFun 视频下载"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/server/index.js",
      "resources/server/sidecar.json",
      "resources/web"
    ],
    "externalBin": [
      "binaries/acfun-server"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
